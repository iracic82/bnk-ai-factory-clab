#!/usr/bin/env bash
# Builds the whole lab on the one VM at track start. The custom image already carries the tooling and the
# registry mirrors full of images, so this is: clone the lab, write secrets to disk, fabric + kind, BNK, AI
# layer, agents, guardrails. Every install step is idempotent, and Instruqt re-runs this script from the top if
# the host is unreachable part way through.
#
# Secrets arrive as team secrets in the environment (config.yml). None lives in the repository.
set -euo pipefail
exec > >(tee -a /var/log/setup-factory.log) 2>&1
fail() { echo; echo "FAILED: $*" >&2; exit 1; }
step() { echo; echo "### $(date -u +%H:%M:%S) $*"; }

LAB_ROOT="${LAB_ROOT:-/root/lab}"
SECRETS_DIR="${SECRETS_DIR:-/root/.bnk}"
LAB_REPO="${LAB_REPO:-github.com/iracic82/bnk-ai-factory-clab.git}"
LAB_REF="${LAB_REF:-main}"

step "secrets present"
for s in FAR_PULL_B64 BNK_LICENSE_JWT GH_READ_TOKEN; do
  [ -n "${!s:-}" ] || fail "$s is not set. Add it as a team secret and list it in config.yml."
done
umask 077; mkdir -p "$SECRETS_DIR"
printf '%s' "$FAR_PULL_B64" > "$SECRETS_DIR/cne_pull_64.json"
printf '%s' "$BNK_LICENSE_JWT" > "$SECRETS_DIR/license.jwt"
[ -n "${AI_CALYPSO_API:-}" ] && printf '%s' "$AI_CALYPSO_API" > "$SECRETS_DIR/calypso-api-key"
[ -n "${AI_CALYPSO_PROJECT:-}" ] && printf '%s' "$AI_CALYPSO_PROJECT" > "$SECRETS_DIR/calypso-project-id"
[ -n "${AI_CALYPSO_URL:-}" ] && printf '%s' "$AI_CALYPSO_URL" > "$SECRETS_DIR/calypso-url"
unset AI_CALYPSO_API AI_CALYPSO_PROJECT
umask 022

step "lab repository"
if [ -d "$LAB_ROOT/.git" ]; then git -C "$LAB_ROOT" fetch -q origin "$LAB_REF" && git -C "$LAB_ROOT" checkout -q FETCH_HEAD
else git clone -q --depth 1 --branch "$LAB_REF" "https://x-access-token:${GH_READ_TOKEN}@${LAB_REPO}" "$LAB_ROOT"; fi
git -C "$LAB_ROOT" remote set-url origin "https://${LAB_REPO}"     # the token stays out of .git/config
unset GH_READ_TOKEN
# LAB_PUBLIC=1: the UIs (Polaris, Grafana, Prometheus, kagent) bind the VM's address, which is what the Instruqt
# tabs on ports 30443/30300/30909/30808 connect to; the sandbox network is private to the learner
export SECRETS_DIR LICENSE_FILE=license.jwt KUBECONFIG="$LAB_ROOT/clab/kubeconfig" LAB_PUBLIC=1
cd "$LAB_ROOT"

step "host (hugepages, limits; already baked, this re-asserts after boot)"
bash install/00-host-prep.sh
step "registry mirrors"
bash install/05-registry-mirrors.sh
step "fabric + kind"
bash install/10-fabric.sh
step "cluster"
bash install/20-cluster.sh
step "BNK"
bash install/30-bnk.sh
step "BNK on the fabric"
bash install/35-bnk-network.sh
# The learner is root on this VM. The FAR credential and the licence token have done their work (images sit in
# the mirrors' cache, the licence is a License CR), so they leave the disk here. The CalypsoAI key stays only
# if chapter 10 is to use the real service; 60-guardrails.sh reads it and shreds it too.
shred -u "$SECRETS_DIR/cne_pull_64.json" "$SECRETS_DIR/license.jwt" 2>/dev/null || true
unset FAR_PULL_B64 BNK_LICENSE_JWT
# The layers above BNK: a failure here is reported in /var/log/setup-factory.log and the chapter that needs the
# layer says so in its check, but it does not take the whole start down with it.
for s in 40-ai 45-observability 50-agents 60-guardrails; do
  [ -x "install/$s.sh" ] || continue
  step "$s"
  bash "install/$s.sh" || echo "WARNING: install/$s.sh failed; see above. The lab starts without that layer."
done

step "Lab Topology tab (port 5050 on the VM address)"
# the live topology page every chapter has as a tab; reads docker, the cluster, leaf1 and openshell, nothing more
BIND=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1)
cat > /etc/systemd/system/lab-topology.service <<UNIT
[Unit]
Description=lab topology page: ${BIND:-0.0.0.0}:5050
After=network-online.target docker.service
[Service]
Environment=KUBECONFIG=$LAB_ROOT/clab/kubeconfig
ExecStart=/usr/bin/python3 $LAB_ROOT/instruqt/bnk-ai-factory-clab/scripts/topology-api.py --bind ${BIND:-0.0.0.0} --port 5050
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload; systemctl enable --now lab-topology >/dev/null 2>&1; systemctl restart lab-topology

step "learner shell"
cat > /etc/profile.d/factory.sh <<EOF
export KUBECONFIG=$LAB_ROOT/clab/kubeconfig LAB_ROOT=$LAB_ROOT
cd $LAB_ROOT 2>/dev/null || true
EOF
echo "READY $(date -u +%H:%M:%S)"
