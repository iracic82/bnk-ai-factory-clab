#!/usr/bin/env bash
set -uo pipefail
export KUBECONFIG=/root/lab/clab/kubeconfig
openshell sandbox exec --name tenant-a-agent -- python3 -c 'import urllib.request as u
try: u.urlopen("http://172.16.100.21/v1/models", timeout=8)
except Exception: pass' >/dev/null 2>&1 || true
openshell policy get tenant-a-agent --base 2>/dev/null | grep -q 'borealis' && openshell policy update tenant-a-agent --remove-rule borealis --wait >/dev/null 2>&1
exit 0
