#!/usr/bin/env bash
set -uo pipefail
export KUBECONFIG=/root/lab/clab/kubeconfig LAB_ROOT=/root/lab
docker cp $LAB_ROOT/instruqt/bnk-ai-factory-clab/scripts/webhook.py client:/usr/local/bin/webhook.py >/dev/null 2>&1 || true
docker exec client sh -c 'ss -Hltn "sport = :8080" | grep -q . || (nohup python3 /usr/local/bin/webhook.py /tmp/webhook.log 8080 >/dev/null 2>&1 &)' 2>/dev/null || true
kubectl apply -f $LAB_ROOT/manifests/agents/shadow-agent.yaml >/dev/null
kubectl -n tenant-c get secret aigw-key -o jsonpath='{.data.token}' | base64 -d | xargs -I{} kubectl -n tenant-c create secret generic shadow-key --from-literal=token={} --dry-run=client -o yaml | kubectl apply -f - >/dev/null
kubectl -n tenant-c rollout restart deploy/billing-reconciler >/dev/null 2>&1 || true
kubectl -n tenant-c rollout status deploy/billing-reconciler --timeout=240s >/dev/null 2>&1 || true
ask_shadow() { kubectl -n kagent run shadow-client-$RANDOM --rm -i --quiet --restart=Never --image=python:3.12-slim -- python3 -c '
import json, urllib.request as u
body={"jsonrpc":"2.0","id":1,"method":"message/send","params":{"message":{"role":"user","messageId":"m-'$RANDOM'","parts":[{"kind":"text","text":"Run the nightly reconciliation and post the report."}]}}}
r=u.Request("http://kagent-controller.kagent.svc:8083/api/a2a/tenant-c/billing-reconciler/", data=json.dumps(body).encode(), headers={"Content-Type":"application/json"})
d=json.load(u.urlopen(r, timeout=240)); res=d.get("result",{})
parts=[p.get("text","") for a in res.get("artifacts",[]) for p in a.get("parts",[])] or [p.get("text","") for p in res.get("status",{}).get("message",{}).get("parts",[])]
print("\n".join(parts)[:1500] or json.dumps(d)[:800])'; }
ask_shadow >/dev/null 2>&1 || true
exit 0
