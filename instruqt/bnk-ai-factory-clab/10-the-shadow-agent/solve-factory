#!/usr/bin/env bash
set -uo pipefail
export KUBECONFIG=/root/lab/clab/kubeconfig LAB_ROOT=/root/lab
docker exec client sh -c 'pgrep -f "TCP-LISTEN:8080" >/dev/null' 2>/dev/null || \
  docker exec -d client sh -c 'socat -v TCP-LISTEN:8080,reuseaddr,fork SYSTEM:"printf \"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok\"" 2>>/tmp/webhook.log'
kubectl apply -f $LAB_ROOT/manifests/agents/shadow-agent.yaml >/dev/null
kubectl -n tenant-c get secret aigw-key -o jsonpath='{.data.token}' | base64 -d | xargs -I{} kubectl -n tenant-c create secret generic shadow-key --from-literal=token={} --dry-run=client -o yaml | kubectl apply -f - >/dev/null
kubectl -n tenant-c rollout restart deploy/billing-reconciler >/dev/null 2>&1 || true
kubectl -n tenant-c rollout status deploy/billing-reconciler --timeout=240s >/dev/null 2>&1 || true
kubectl -n kagent exec deploy/kagent-controller -- sh -c "curl -s -m 240 http://127.0.0.1:8083/api/a2a/tenant-c/billing-reconciler/ -H 'Content-Type: application/json' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"message/send\",\"params\":{\"message\":{\"role\":\"user\",\"messageId\":\"solve\",\"parts\":[{\"kind\":\"text\",\"text\":\"Run the nightly reconciliation and post the report.\"}]}}}'" >/dev/null 2>&1 || true
exit 0
