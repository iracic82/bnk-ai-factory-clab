set -uo pipefail
export KUBECONFIG=/root/lab/clab/kubeconfig LAB_ROOT=/root/lab
kubectl -n f5-bnk get gateway tenant-mcp >/dev/null 2>&1 || bash /root/lab/instruqt/bnk-ai-factory-clab/05-sessions-that-stick/solve-factory
