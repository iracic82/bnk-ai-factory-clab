#!/usr/bin/env bash
set -uo pipefail
export KUBECONFIG=/root/lab/clab/kubeconfig
[ "$(kubectl -n f5-bnk get f5-big-cne-irules tenant-stamp -o jsonpath='{.status.conditions[-1].status}' 2>/dev/null)" = True ] \
  || fail-message "F5BigCneIrule f5-bnk/tenant-stamp is missing or not Ready (apply manifests/chapters/06-stamp-irule.yaml)."
kubectl -n f5-bnk get netpolicy tenant-mcp-sessions -o jsonpath='{range .spec.extensionRefs[*]}{.name} {end}' 2>/dev/null | grep -q tenant-stamp \
  || fail-message "NetPolicy f5-bnk/tenant-mcp-sessions does not list the iRule tenant-stamp in its extensionRefs."
out=$(docker exec client curl -s -m 5 -i http://172.16.100.23/factory/whoami 2>/dev/null)
echo "$out" | grep -q 'X-Factory-Tenant: tenant-a' || fail-message "GET /factory/whoami on 172.16.100.23 did not come back with X-Factory-Tenant: tenant-a; the iRule is not on the listener yet."
exit 0
